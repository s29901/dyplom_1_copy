  m_Script: {fileID: 11500000, guid: 90b1af8943794c7f870ab17e35297c59, type: 3}
  m_Name: Q3_IntroPart2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Hero
    speakerPortrait: {fileID: 21300000, guid: 328299f545de847ceacf5a3f77c61e3b, type: 3}
    speakerOnRight: 0
    text: "Na co czekają?"
  - speakerName: Ptak
    speakerPortrait: {fileID: 21300000, guid: 814c022e8e6ed4362b52687eafbba823, type: 3}
    speakerOnRight: 1
    text: "Aż ktoś ich wysłucha. Nie naprawi. Nie przegoni. Po prostu wysłucha."
  - speakerName: Ptak
    speakerPortrait: {fileID: 21300000, guid: 814c022e8e6ed4362b52687eafbba823, type: 3}
    speakerOnRight: 1
    text: "Wysłuchasz ich?"
    choiceA: "A jeśli powiem coś nie tak?"
    choiceB: "Spróbuję."
    choiceKeyA: q3_wrongwords
    choiceKeyB: q3_try
    reactionA: "Nie potrzebujesz właściwych słów. Wystarczy, że zostaniesz."
    reactionB: "O nic więcej nigdy nie prosiły."
