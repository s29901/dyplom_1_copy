MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 90b1af8943794c7f870ab17e35297c59, type: 3}
  m_Name: Q2_IntroPart1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Bird
    speakerPortrait: {fileID: 21300000, guid: 814c022e8e6ed4362b52687eafbba823, type: 3}
    speakerOnRight: 1
    text: "Tutaj czuć coś innego, prawda?"
  - speakerName: Hero
    speakerPortrait: {fileID: 21300000, guid: 328299f545de847ceacf5a3f77c61e3b, type: 3}
    speakerOnRight: 0
    text: "Wszystko jest szare... A chmury takie ciężkie."
  - speakerName: Bird
    speakerPortrait: {fileID: 21300000, guid: 814c022e8e6ed4362b52687eafbba823, type: 3}
    speakerOnRight: 1
    text: "Ta część ogrodu od dawna czeka na deszcz."
  - speakerName: Hero
    speakerPortrait: {fileID: 21300000, guid: 328299f545de847ceacf5a3f77c61e3b, type: 3}
    speakerOnRight: 0
    text: "Nie lubię deszczu. Ani płaczu. Nigdy niczego nie naprawił."
  - speakerName: Bird
    speakerPortrait: {fileID: 21300000, guid: 814c022e8e6ed4362b52687eafbba823, type: 3}
    speakerOnRight: 1
    text: "Duszenie tego w sobie też niczego nie naprawiło. Prawda?"
    choiceA: "..."
    choiceB: "...Nie. Nie naprawiło."
    choiceKeyA: q2_silent
    choiceKeyB: q2_admit
    reactionA: "Nie każda roślina rośnie od samego słońca."
    reactionB: "Trzeba było odwagi, żeby to powiedzieć. Nie każda roślina rośnie od samego słońca."
