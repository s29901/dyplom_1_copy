%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 90b1af8943794c7f870ab17e35297c59, type: 3}
  m_Name: IntroGardenDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Ptak
    speakerPortrait: {fileID: 21300000, guid: 814c022e8e6ed4362b52687eafbba823, type: 3}
    speakerOnRight: 1
    text: "Jesteś. Zaczynało mi się już wydawać, że nigdy nie wrócisz."
  - speakerName: Hero
    speakerPortrait: {fileID: 21300000, guid: 328299f545de847ceacf5a3f77c61e3b, type: 3}
    speakerOnRight: 0
    text: "Wrócę? Przecież nigdy mnie tu nie było."
  - speakerName: Ptak
    speakerPortrait: {fileID: 21300000, guid: 814c022e8e6ed4362b52687eafbba823, type: 3}
    speakerOnRight: 1
    text: "Było. Dawno temu. To twój ogród."
  - speakerName: Hero
    speakerPortrait: {fileID: 21300000, guid: 328299f545de847ceacf5a3f77c61e3b, type: 3}
    speakerOnRight: 0
    text: "Mój? Ale tu wszystko jest... połamane."
  - speakerName: Ptak
    speakerPortrait: {fileID: 21300000, guid: 814c022e8e6ed4362b52687eafbba823, type: 3}
    speakerOnRight: 1
    text: "Nikt się nim nie zaopiekował wtedy, kiedy najbardziej tego potrzebował. To nie była twoja wina. Ale teraz tylko ty możesz przywrócić go do życia."
  - speakerName: Hero
    speakerPortrait: {fileID: 21300000, guid: 328299f545de847ceacf5a3f77c61e3b, type: 3}
    speakerOnRight: 0
    text: "Nie umiem niczego naprawiać."
  - speakerName: Ptak
    speakerPortrait: {fileID: 21300000, guid: 814c022e8e6ed4362b52687eafbba823, type: 3}
    speakerOnRight: 1
    text: "Na początku nikt nie umie. Widzisz to małe drzewko? Wciąż żyje. To wystarczy, żeby zacząć."
    choiceA: "A jeśli mi się nie uda?"
    choiceB: "To tylko jedno małe drzewko."
    choiceKeyA: intro_fail
    choiceKeyB: intro_smalltree
    reactionA: "To spróbujemy jeszcze raz. Ogrody są cierpliwe."
    reactionB: "Każdy ogród zaczyna się od jednego drzewa. Nie lekceważ go."
  - speakerName: Hero
    speakerPortrait: {fileID: 21300000, guid: 328299f545de847ceacf5a3f77c61e3b, type: 3}
    speakerOnRight: 0
    text: "...Dobrze. Pokaż mi."
