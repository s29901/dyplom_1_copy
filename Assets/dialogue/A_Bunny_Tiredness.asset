MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 90b1af8943794c7f870ab17e35297c59, type: 3}
  m_Name: A_Bunny_Tiredness
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Zajączek
    speakerPortrait: {fileID: 0}
    speakerOnRight: 1
    text: "Ledwo trzymam otwarte oczy... ale nie wolno mi przestać. Tyle jeszcze zostało do zrobienia. Zawsze zostaje tyle do zrobienia."
    choiceA: "Wiesz, wolno ci odpocząć."
    choiceB: "To pospiesz się i skończ wszystko!"
    choiceKeyA: a_tired_listen
    choiceKeyB: a_tired_fix
    reactionA: "Wolno...? Nikt nigdy nie powiedział mi tego słowa."
    reactionB: "To właśnie ten pośpiech... tak mnie zmęczył. Może... może mógłbym się na chwilę zatrzymać."
  - speakerName: Zajączek
    speakerPortrait: {fileID: 0}
    speakerOnRight: 1
    text: "Samo powiedzenie tego na głos sprawia, że uszy robią mi się lżejsze. Może świat poczeka jeden wieczór."
