%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 90b1af8943794c7f870ab17e35297c59, type: 3}
  m_Name: EndingDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Ptak
    speakerPortrait: {fileID: 21300000, guid: 814c022e8e6ed4362b52687eafbba823, type: 3}
    speakerOnRight: 1
    text: "Spójrz na swoje drzewo."
  - speakerName: Hero
    speakerPortrait: {fileID: 21300000, guid: 328299f545de847ceacf5a3f77c61e3b, type: 3}
    speakerOnRight: 0
    text: "Jest teraz takie wysokie... Kiedy to się stało?"
  - speakerName: Ptak
    speakerPortrait: {fileID: 21300000, guid: 814c022e8e6ed4362b52687eafbba823, type: 3}
    speakerOnRight: 1
    text: "Wtedy, kiedy nikt nie patrzył. Tak właśnie rosną rzeczy."
  - speakerName: Ptak
    speakerPortrait: {fileID: 21300000, guid: 814c022e8e6ed4362b52687eafbba823, type: 3}
    speakerOnRight: 1
    text: "Pamiętasz to pytanie: a jeśli mi się nie uda? Odpowiedź nigdy nie była ci potrzebna."
    requiredChoiceKey: intro_fail
  - speakerName: Ptak
    speakerPortrait: {fileID: 21300000, guid: 814c022e8e6ed4362b52687eafbba823, type: 3}
    speakerOnRight: 1
    text: "Kiedyś było to „tylko jedno małe drzewko”. Spójrz na nie teraz."
    requiredChoiceKey: intro_smalltree
  - speakerName: Ptak
    speakerPortrait: {fileID: 21300000, guid: 814c022e8e6ed4362b52687eafbba823, type: 3}
    speakerOnRight: 1
    text: "I ani jedno twoje słowo nie okazało się tym niewłaściwym. Wystarczyła sama twoja obecność."
    requiredChoiceKey: q3_wrongwords
  - speakerName: Ptak
    speakerPortrait: {fileID: 21300000, guid: 814c022e8e6ed4362b52687eafbba823, type: 3}
    speakerOnRight: 1
    text: "Odpoczynek wydawał ci się stratą czasu. A jednak jesteśmy tutaj."
    requiredChoiceKey: q4_waste
  - speakerName: Hero
    speakerPortrait: {fileID: 21300000, guid: 328299f545de847ceacf5a3f77c61e3b, type: 3}
    speakerOnRight: 0
    text: "Czy z ogrodem będzie dobrze, kiedy odejdę?"
  - speakerName: Ptak
    speakerPortrait: {fileID: 21300000, guid: 814c022e8e6ed4362b52687eafbba823, type: 3}
    speakerOnRight: 1
    text: "Nigdzie nie odchodzisz. To twój ogród. Jest z tobą wszędzie."
  - speakerName: Ptak
    speakerPortrait: {fileID: 21300000, guid: 814c022e8e6ed4362b52687eafbba823, type: 3}
    speakerOnRight: 1
    text: "Będą tu dni deszczowe. Będą dni chłodne. Ale teraz już wiesz, co robić."
  - speakerName: Hero
    speakerPortrait: {fileID: 21300000, guid: 328299f545de847ceacf5a3f77c61e3b, type: 3}
    speakerOnRight: 0
    text: "Wracać. Przynosić ciepło. Pozwalać deszczowi padać. Mówić. Odpoczywać."
  - speakerName: Ptak
    speakerPortrait: {fileID: 21300000, guid: 814c022e8e6ed4362b52687eafbba823, type: 3}
    speakerOnRight: 1
    text: "A ja tu będę. Za każdym razem."
