MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 90b1af8943794c7f870ab17e35297c59, type: 3}
  m_Name: A_Bunny_Fear
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Bunny
    speakerPortrait: {fileID: 0}
    speakerOnRight: 1
    text: "N-nie podchodź bliżej! ...Nie, czekaj. Nie odchodź. Nigdy nie wiem, czego właściwie chcę."
    choiceA: "Można się bać. Zostanę tutaj, przy tobie."
    choiceB: "Nie ma się czego bać!"
    choiceKeyA: a_fear_listen
    choiceKeyB: a_fear_fix
    reactionA: "Ty... nie śmiejesz się ze mnie? Strach robi się mniejszy, kiedy ktoś przy nim zostaje."
    reactionB: "Ale ja się boję. Kiedy mówisz, że to nic, wciąż się boję — tylko już całkiem sam."
  - speakerName: Bunny
    speakerPortrait: {fileID: 0}
    speakerOnRight: 1
    text: "Wciąż trochę się boję. Ale to już nie jest ten samotny strach. To co innego. To lepsze."
