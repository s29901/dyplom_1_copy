MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 90b1af8943794c7f870ab17e35297c59, type: 3}
  m_Name: A_Bunny_Anger
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Zajączek
    speakerPortrait: {fileID: 0}
    speakerOnRight: 1
    text: "Odejdź! ...Nie. Zostań. Nie wiem! Wszystko jest NIESPRAWIEDLIWE i nikogo to nie obchodzi!"
    choiceA: "Brzmisz na naprawdę wściekłego."
    choiceB: "Uspokój się, to nic takiego."
    choiceKeyA: a_anger_listen
    choiceKeyB: a_anger_fix
    reactionA: "BO JESTEM wściekły! I... dobrze mi z tym, że ktoś to w końcu po prostu widzi. I nie ucieka wzrokiem."
    reactionB: "„Uspokój się” jeszcze nikogo w dziejach świata nie uspokoiło. Pozwól mi po prostu przez chwilę być wściekłym."
  - speakerName: Zajączek
    speakerPortrait: {fileID: 0}
    speakerOnRight: 1
    text: "...Ogień zrobił się mniejszy. Tak już z nim jest, kiedy wolno mu chwilę popalić. Dziękuję, że nie uciekasz."
