MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 90b1af8943794c7f870ab17e35297c59, type: 3}
  m_Name: A_Bunny_Sadness
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Bunny
    speakerPortrait: {fileID: 0}
    speakerOnRight: 1
    text: "Och... nie patrz na mnie. Jestem po prostu smutny. Dzisiaj. I wczoraj. I przedwczoraj też."
    choiceA: "Chcesz mi o tym opowiedzieć?"
    choiceB: "Nie smuć się! Głowa do góry!"
    choiceKeyA: a_sad_listen
    choiceKeyB: a_sad_fix
    reactionA: "...Tak. Właściwie chcę. Nikt nigdy nie pyta."
    reactionB: "„Głowa do góry” nigdy nie działa. Może po prostu... posiedzisz ze mną? To pomaga."
  - speakerName: Bunny
    speakerPortrait: {fileID: 0}
    speakerOnRight: 1
    text: "Dziękuję ci za to, że słuchasz. Smutek wciąż tu jest... ale robi się lżejszy, kiedy przestaje być tajemnicą."
