  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 90b1af8943794c7f870ab17e35297c59, type: 3}
  m_Name: A_Bunny_Hurt
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Zajączek
    speakerPortrait: {fileID: 0}
    speakerOnRight: 1
    text: "Zapomnieli o mnie. Zawsze zapominają. To było tak dawno... więc dlaczego wciąż piecze?"
    choiceA: "To naprawdę zabolało, prawda?"
    choiceB: "Po prostu zapomnij. To już przeszłość."
    choiceKeyA: a_hurt_listen
    choiceKeyB: a_hurt_fix
    reactionA: "Tak. Zabolało. Dziękuję, że nie udajesz, że było inaczej."
    reactionB: "Próbowałem zapominać. Codziennie. To nie działa. Żal musi zostać wysłuchany, zanim odejdzie."
  - speakerName: Zajączek
    speakerPortrait: {fileID: 0}
    speakerOnRight: 1
    text: "Może pieczenie mija, kiedy ktoś już o nim wie. Piecze już trochę mniej."
