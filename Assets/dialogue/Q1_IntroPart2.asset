MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 90b1af8943794c7f870ab17e35297c59, type: 3}
  m_Name: Q1_IntroPart2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Hero
    speakerPortrait: {fileID: 21300000, guid: 328299f545de847ceacf5a3f77c61e3b, type: 3}
    speakerOnRight: 0
    text: "Moje drzewko wygląda tu na takie małe."
  - speakerName: Bird
    speakerPortrait: {fileID: 21300000, guid: 814c022e8e6ed4362b52687eafbba823, type: 3}
    speakerOnRight: 1
    text: "Tak. Od bardzo dawna czeka na ciepło."
  - speakerName: Hero
    speakerPortrait: {fileID: 21300000, guid: 328299f545de847ceacf5a3f77c61e3b, type: 3}
    speakerOnRight: 0
    text: "A słońce nie może go ogrzać samo?"
  - speakerName: Bird
    speakerPortrait: {fileID: 21300000, guid: 814c022e8e6ed4362b52687eafbba823, type: 3}
    speakerOnRight: 1
    text: "Może. Ale najpierw ktoś musi przynieść je bliżej."
    choiceA: "Dlaczego ja? Ledwo starcza mi ciepła dla siebie."
    choiceB: "To brzmi zbyt prosto."
    choiceKeyA: q1_doubt
    choiceKeyB: q1_simple
    reactionA: "Właśnie dlatego. Niektóre rzeczy zaczynają rosnąć dopiero wtedy, gdy poświęcimy im uwagę. Ty też."
    reactionB: "O najprostszych rzeczach zapominamy najczęściej."
